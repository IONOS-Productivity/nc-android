<resources>
    <style name="FullScreenAudioPlayerTimeTextViewStyle">
        <item name="android:layout_width">@dimen/player_full_screen_audio_player_time_text_view_large_width
        </item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:alpha">@dimen/player_account_view_alpha</item>
        <item name="android:textColor">@color/player_full_screen_audio_player_time_text_view_color</item>
        <item name="android:textSize">@dimen/player_full_screen_audio_player_time_text_view_font_size
        </item>
    </style>

    <style name="FullScreenAudioPlayerSeekBarStyle" parent="@android:style/Widget.SeekBar">
        <item name="android:progressDrawable">@drawable/player_full_screen_audio_player_progressbar</item>
        <item name="android:thumb">@drawable/player_full_screen_audio_player_progressbar_thumb</item>
        <item name="android:minHeight">@dimen/player_full_screen_audio_player_progress_height</item>
        <item name="android:maxHeight">@dimen/player_full_screen_audio_player_progress_height</item>
    </style>

    <style name="FullScreenAudioPlayerSmallButtonWithRightMarginStyle" parent="FullScreenAudioPlayerSmallButtonStyle">
        <item name="android:layout_marginRight">@dimen/player_full_screen_audio_player_button_margin_right</item>
    </style>

    <style name="FullScreenAudioPlayerSmallButtonStyle">
        <item name="android:layout_width">@dimen/player_full_screen_audio_player_small_button_size</item>
        <item name="android:layout_height">@dimen/player_full_screen_audio_player_small_button_size</item>
        <item name="android:layout_marginTop">@dimen/player_full_screen_audio_player_small_button_bottom_top_margin</item>
        <item name="android:layout_marginBottom">@dimen/player_full_screen_audio_player_small_button_bottom_top_margin</item>
    </style>

    <style name="FullScreenAudioPlayerBigButtonWithRightMarginStyle" parent="FullScreenAudioPlayerBigButtonStyle">
        <item name="android:layout_marginRight">@dimen/player_full_screen_audio_player_button_margin_right</item>
    </style>

    <style name="FullScreenAudioPlayerBigButtonStyle">
        <item name="android:layout_width">@dimen/player_full_screen_audio_player_big_button_size</item>
        <item name="android:layout_height">@dimen/player_full_screen_audio_player_big_button_size</item>
        <item name="android:layout_marginTop">@dimen/player_full_screen_audio_player_big_button_bottom_top_margin</item>
        <item name="android:layout_marginBottom">@dimen/player_full_screen_audio_player_big_button_bottom_top_margin</item>
    </style>
</resources>