<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background_color">

    <com.ionos.player.ui.pager.PlayerPager
        android:id="@+id/playerPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/player_video_toolbar_background_color"
            android:gravity="center_vertical"
            android:minHeight="@dimen/player_toolbar_height"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="@dimen/player_back_button_margin_start"
                android:layout_marginRight="@dimen/player_back_button_margin_end"
                android:layout_marginVertical="4dp"
                android:src="@drawable/ic_arrow_back"
                custom:tint="@color/player_toolbar_icon_color" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/player_toolbar_text_color"
                android:textSize="@dimen/player_toolbar_text_size" />

            <ImageView
                android:id="@+id/more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_dots_vertical"
                custom:tint="@color/player_toolbar_icon_color" />

        </LinearLayout>

        <com.ionos.player.ui.control.PlayerControlView
            android:id="@+id/playerControlView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_gravity="bottom"
            android:background="@color/player_video_control_view_background_color" />

    </RelativeLayout>

</FrameLayout>