<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavigationBarIconStyle">
        <item name="android:layout_width">@dimen/contextbar_context_action_bar_item_width</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:paddingBottom">@dimen/contextbar_navigation_bar_item_padding_bottom</item>
        <item name="android:paddingTop">@dimen/contextbar_navigation_bar_item_padding_top</item>
    </style>

    <style name="NavigationBarMoreIconStyle" parent="NavigationBarIconStyle">
        <item name="android:layout_width">@dimen/contextbar_navigation_bar_more_item_width</item>
        <item name="android:layout_marginLeft">@dimen/contextbar_navigation_bar_more_item_margin_left</item>
        <item name="android:layout_marginRight">@dimen/contextbar_navigation_bar_more_item_margin_right</item>
    </style>

</resources>