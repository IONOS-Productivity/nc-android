<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/llRoot"
	android:layout_width="wrap_content"
	android:layout_height="@dimen/contextbar_navigation_bar_height"
	android:orientation="horizontal">

	<LinearLayout
		android:id="@+id/llButtonsPlace"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:layout_marginLeft="@dimen/contextbar_cab_buttons_place_margin_left"
		android:layout_marginRight="@dimen/contextbar_cab_buttons_place_margin_right"
		android:orientation="horizontal"/>

	<ImageButton
		android:id="@+id/ibMore"
		style="@style/NavigationBarMoreIconStyle"
		android:background="@color/transparent"
		android:paddingLeft="@dimen/contextbar_cab_more_item_padding_left"
		android:paddingRight="@dimen/contextbar_cab_more_item_padding_right"
		android:visibility="visible"/>

</LinearLayout>